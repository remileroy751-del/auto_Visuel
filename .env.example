# Copie ce fichier en ".env" et remplis tes clés. Ne le publie JAMAIS sur GitHub.
# Plusieurs clés possibles par service, séparées par une virgule (rotation automatique si quota atteint)
GEMINI_API_KEY=
GROQ_API_KEY=
# Photos de fond professionnelles (clé gratuite : https://www.pexels.com/api/)
PEXELS_API_KEY=
# Illustrations IA de fond (clé sk_... sur https://enter.pollinations.ai)
POLLINATIONS_API_KEY=

# Facebook (Page uniquement)
FB_PAGE_ID=
FB_PAGE_TOKEN=

# TikTok (Content Posting API)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
